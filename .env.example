# =====================================================================
# Pediatric ASD Screening Decision Support System (CDSS)
# Frontend Environment Variables Configuration
# =====================================================================

# Base URL for the FastAPI MediaPipe / OpenCV Computer Vision backend telemetry API.
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production Cloud Server:
# When hosting your backend on a cloud provider (e.g. Render, Google Cloud Run, AWS, Fly.io),
# set this environment variable in your Netlify site settings to your live backend domain:
# NEXT_PUBLIC_API_URL=https://asd-screening-api.onrender.com
